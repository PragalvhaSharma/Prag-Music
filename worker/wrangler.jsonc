{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prag-music",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true }
  // Files live in a private Backblaze B2 bucket. Everything account-specific is a
  // Worker secret set by scripts/setup.sh (and .dev.vars for local dev):
  // APP_TOKEN, ADMIN_TOKEN, B2_ENDPOINT, B2_REGION, B2_BUCKET, B2_KEY_ID, B2_APP_KEY.
}
