{
  "version": 3,
  "routes": [
    {
      "src": "/_expo/static/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": { "Referrer-Policy": "no-referrer", "X-Content-Type-Options": "nosniff" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(_expo|assets)/.*", "status": 404 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
